---
import { siteConfig } from "../config/site";

interface Props {
  type?: "Person" | "WebSite";
}

const { type = "Person" } = Astro.props;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.author,
  url: siteConfig.url,
  jobTitle: "Software Engineer",
  sameAs: [
    `https://twitter.com/${siteConfig.twitter.creator.replace("@", "")}`,
    "https://github.com/luisrondow",
    "https://linkedin.com/in/luisrondow",
  ],
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: siteConfig.url,
  author: {
    "@type": "Person",
    name: siteConfig.author,
  },
};

const schema = type === "Person" ? personSchema : webSiteSchema;
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
