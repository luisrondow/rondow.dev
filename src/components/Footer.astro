---
const LINKS = [
  { name: "github", url: "https://github.com/luisrondow" },
  { name: "linkedin", url: "https://linkedin.com/in/luisrondow" },
  { name: "x", url: "https://x.com/rond0w" },
];
---

<footer class="bg-header-bg">
  <nav
    class="flex h-10 items-center justify-center px-3 sm:h-11 sm:px-4 md:px-6"
    aria-label="Social links"
  >
    <div class="flex items-center gap-3 sm:gap-4">
      {
        LINKS.map(({ name, url }) => (
          <a
            class="text-xs lowercase underline hover:opacity-80 sm:text-sm"
            href={url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {name}
          </a>
        ))
      }
    </div>
  </nav>
</footer>
