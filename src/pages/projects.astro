---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import projectsData from "../data/projects.json";
import { pageSEO } from "../config/site";

const { projects } = projectsData;
---

<Layout {...pageSEO.projects} routeName="projects">
  <main class="px-4 pb-10 pt-8 sm:pb-14 sm:pt-12 md:px-6">
    <SectionHeader text="projects" />

    <div class="mt-6 flex flex-col gap-6 sm:mt-8 sm:gap-8">
      {
        projects.map((project) => (
          <article class="flex flex-col gap-2">
            <a
              class="text-base text-link underline hover:opacity-80 sm:text-lg"
              href={project.href}
            >
              {project.name}
            </a>
            <p class="text-sm text-text sm:text-base">{project.description}</p>
            <div class="mt-1 flex flex-wrap gap-2">
              {project.tech.map((t) => (
                <span class="text-xs text-muted">{t}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </main>
</Layout>
