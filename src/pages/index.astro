      <div class="flex flex-col gap-2.5">
        <h1 class="text-3xl italic sm:text-4xl md:text-[44px]">{profile.name}</h1>
        <div class="flex flex-col gap-1.5">
          <span class="text-sm text-muted">{profile.location}</span>
          <span class="text-sm text-muted">{profile.role}</span>
        </div>
        <p class="text-sm text-text sm:text-[15px]">
          {bio}<a class="text-link underline hover:opacity-80" href={bioLink.href}>{bioLink.text}</a>{bioSuffix}
        </p>
      </div>
    </section>

    <!-- Content Grid -->
    <section
      class="mt-8 grid grid-cols-1 gap-12 sm:mt-11 sm:gap-16 md:grid-cols-2 md:gap-20 lg:gap-[100px]"
    >
      <!-- Work Column -->
      <div class="flex flex-col gap-5 sm:gap-[22px]">
        <SectionHeader text="work" />

        <div class="flex flex-col gap-5 sm:gap-[22px]">
          {
            work.map((item) => (
              <WorkItem
                name={item.name}
                href={item.href}
                role={item.role}
                dates={item.dates}
                description={item.description}
              />
            ))
          }
        </div>
      </div>

      <!-- Projects Column -->
      <div class="flex flex-col gap-5 sm:gap-[22px]">
        <SectionHeader text="projects" />

        <div class="flex flex-col gap-5">
          {
            projects.map((item) => (
              <ProjectItem
                name={item.name}
                href={item.href}
                description={item.description}
              />
            ))
          }
        </div>

        <a class="text-link underline hover:opacity-80" href={allProjectsLink}
          >all projects &rarr;</a
        >
      </div>
    </section>
  </main>
</Layout>
